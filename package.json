{
  "name": "iconhub",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "cf:dev": "bun run build:sets && wrangler dev",
    "deploy": "bun run build:sets && wrangler deploy",
    "build:sets": "bun run scripts/generate-sets.ts",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.13.3",
    "http-errors": "^2.0.1",
    "mime": "^4.1.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "latest",
    "@types/http-errors": "^2.0.5",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.124.0"
  }
}
