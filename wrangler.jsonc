{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iconhub",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-19",
  "send_metrics": false,
  "assets": {
    "directory": "./icons",
    "binding": "ASSETS",
    "run_worker_first": ["/lucide/*", "/tabler/*", "/remix/*"]
  }
}
